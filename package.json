{
  "name": "vitepress-static-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs --host --open",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host",
    "docs:artifact": "npm run docs:build && tar -czf vitepress-site-artifact.tar.gz -C docs/.vitepress dist",
    "docs:master-artifact": "node scripts/build-single-artifact.mjs",
    "docs:single-html-attempt": "VITEPRESS_SINGLE_FILE=true vitepress build docs && rm -rf vitepress-single && cp -r docs/.vitepress/dist vitepress-single"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.4.1",
    "svgo": "^4.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitepress": "^1.5.0",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.13"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^7.3.6"
  }
}
